# Render deployment image. Build context must be the repository root.
FROM python:3.14-slim@sha256:ce40764625a4ff50df3548277632e7f96c4e77fe75fa848aae9885476e7df5a4

ARG C2PATOOL_VERSION=c2patool-v0.27.15
ARG C2PATOOL_SHA256=7a035b727a6cdda8ad08d98fe94b3c20febee4aea4e7c1de02571b295730faf0

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl ffmpeg ghostscript libarchive-zip-perl libimage-exiftool-perl passwd qpdf \
    && rm -rf /var/lib/apt/lists/* \
    && curl -fsSL -o /tmp/c2patool.tar.gz "https://github.com/contentauth/c2pa-rs/releases/download/${C2PATOOL_VERSION}/${C2PATOOL_VERSION}-x86_64-unknown-linux-gnu.tar.gz" \
    && echo "${C2PATOOL_SHA256}  /tmp/c2patool.tar.gz" | sha256sum -c - \
    && tar -xzf /tmp/c2patool.tar.gz -C /tmp \
    && install -m 0755 /tmp/c2patool/c2patool /usr/local/bin/c2patool \
    && rm -rf /tmp/c2patool /tmp/c2patool.tar.gz

COPY service/scripts /app/scripts
COPY config /app/config
COPY web-ui /app/web-ui
RUN chmod -R a+rX /app

RUN useradd --create-home --uid 10001 --shell /usr/sbin/nologin remover
USER remover
WORKDIR /app
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 WATERMARKS_SERVER_VERSION=render
EXPOSE 10000
CMD ["python3", "/app/web-ui/render_app.py"]
